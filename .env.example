# Pflicht: mindestens 32 Zeichen, zufällig (z. B. `openssl rand -hex 32`)
SESSION_SECRET=

# Nur für den allerersten Start: legt den ersten Admin an.
# Danach ADMIN_PASSWORD aus dieser Datei entfernen.
ADMIN_NAME=admin
ADMIN_PASSWORD=

# Optional
PORT=3000
NODE_ENV=development
