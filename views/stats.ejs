<%- include('partials/header', { title: 'Statistik' }) %>
<h1>Statistik</h1>

<nav class="tabs" aria-label="Spielmodus">
  <a href="/stats" class="<%= mode ? '' : 'on' %>">Alle Modi</a>
  <% modes.forEach(function (m) { %>
    <a href="/stats?mode=<%= m.id %>" class="<%= mode && m.id === mode.id ? 'on' : '' %>"><%= m.name %></a>
  <% }) %>
</nav>

<h2>Deine Zahlen<%= mode ? ' · ' + mode.name : '' %></h2>
<section class="stats">
  <div class="card stat"><span class="n"><%= stats.games %></span><span class="l">Spiele</span></div>
  <div class="card stat"><span class="n"><%= stats.wins %></span><span class="l">Siege (<%= pct(stats.quote) %>)</span></div>
  <div class="card stat"><span class="n"><%= stats.best_leg === null ? '–' : stats.best_leg %></span><span class="l">Bestes Leg (Runden)</span></div>
  <div class="card stat"><span class="n"><%= num1(stats.avg_win_rounds) %></span><span class="l">&Oslash; Runden pro Sieg</span></div>
  <div class="card stat"><span class="n"><%= num1(stats.avg) %></span><span class="l">&Oslash; pro Aufnahme</span></div>
  <div class="card stat"><span class="n"><%= num2(stats.per_dart) %></span><span class="l">&Oslash; Punkte pro Wurf</span></div>
  <div class="card stat"><span class="n"><%= num1(stats.first9) %></span><span class="l">&Oslash; erste 3 Aufnahmen</span></div>
  <div class="card stat"><span class="n"><%= stats.best_visit === null ? '–' : stats.best_visit %></span><span class="l">Beste Aufnahme</span></div>
  <div class="card stat"><span class="n"><%= stats.v60 %></span><span class="l">Aufnahmen 60+</span></div>
  <div class="card stat"><span class="n"><%= stats.v100 %></span><span class="l">Aufnahmen 100+</span></div>
  <div class="card stat"><span class="n"><%= stats.v140 %></span><span class="l">Aufnahmen 140+</span></div>
  <div class="card stat"><span class="n"><%= stats.n180 %></span><span class="l">180er</span></div>
  <div class="card stat"><span class="n"><%= stats.best_finish === null ? '–' : stats.best_finish %></span><span class="l">Höchstes Finish</span></div>
  <div class="card stat"><span class="n"><%= stats.legs_with_turns %></span><span class="l">Spiele mit Aufnahmen</span></div>
</section>
<% if (!stats.visits) { %>
  <p class="muted">Average und Finish erscheinen, sobald du beim Erfassen die Aufnahmen einträgst. 180er kannst du auch ohne Aufnahmen eintragen.</p>
<% } %>

<h2>Alle Spieler<%= mode ? ' · ' + mode.name : '' %></h2>
<% if (!leaders.length) { %>
  <p class="muted">Noch keine Aufnahmen erfasst.</p>
<% } else { %>
  <div class="table-wrap">
    <table class="rank">
      <thead>
        <tr><th>Spieler</th><th class="num">&Oslash; Aufnahme</th><th class="num">&Oslash; pro Wurf</th><th class="num">180er</th><th class="num">Höchstes Finish</th><th class="num">Spiele</th></tr>
      </thead>
      <tbody>
        <% leaders.forEach(function (l) { %>
          <tr class="<%= l.user_id === user.id ? 'me' : '' %>">
            <td><%= l.name %></td>
            <td class="num"><%= num1(l.avg) %></td>
            <td class="num"><%= num2(l.per_dart) %></td>
            <td class="num"><%= l.n180 %></td>
            <td class="num"><%= l.best_finish === null ? '–' : l.best_finish %></td>
            <td class="num"><%= l.legs || '–' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <p class="muted small">Average, Finish und Spiele zählen nur Spiele mit eingetragenen Aufnahmen, 180er zählen immer. Eine Checkout-Quote gibt es nicht, weil dafür die Darts auf Doppel pro Runde nötig wären. Stattdessen zeigt die Tabelle das höchste Finish. «Pro Wurf» ist der Average geteilt durch 3 Darts.</p>
<% } %>
<%- include('partials/footer') %>
