<div class="player-row" id="row-<%= i %>">
  <select name="user_id" aria-label="Spieler <%= i + 1 %>">
    <option value="">– Spieler wählen –</option>
    <% users.forEach(function (u) { %>
      <option value="<%= u.id %>" <%= String(u.id) === row.user_id ? 'selected' : '' %>><%= u.name %><%= u.aktiv ? '' : ' (gesperrt)' %></option>
    <% }) %>
  </select>
  <input type="number" name="rounds" min="1" max="99" inputmode="numeric" placeholder="Runden" aria-label="Runden Spieler <%= i + 1 %>" value="<%= row.rounds %>">
  <label class="win"><input type="radio" name="winner" value="<%= i %>" <%= winner === i ? 'checked' : '' %>> Sieger</label>
  <label class="n180">180er <input type="number" name="n180" min="0" max="99" inputmode="numeric" placeholder="0" aria-label="Anzahl 180er Spieler <%= i + 1 %>" value="<%= row.n180 %>"></label>
  <input type="text" name="turns" class="turns" inputmode="numeric" autocomplete="off"
         placeholder="Aufnahmen (optional), z. B. 60 100 140 180 21"
         aria-label="Aufnahmen Spieler <%= i + 1 %>" value="<%= row.turns %>">
</div>
<% if (withOob) { %>
  <% if (i + 1 < maxRows) { %>
    <button id="add-row" type="button" class="btn" hx-swap-oob="true" hx-get="/matches/row?i=<%= i + 1 %>" hx-target="#rows" hx-swap="beforeend">+ Spieler</button>
  <% } else { %>
    <span id="add-row" hx-swap-oob="true"></span>
  <% } %>
<% } %>
