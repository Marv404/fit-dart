<%- include('../partials/header', { title: 'Spielmodi' }) %>
<h1>Spielmodi</h1>
<p><a href="/admin">&larr; Admin</a></p>

<% if (errors.length) { %>
  <div class="flash err" role="alert"><ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div>
<% } %>

<section class="card">
  <h2>Neuer Modus</h2>
  <form method="post" action="/admin/modes" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="two">
      <label>Name <input type="text" name="name" maxlength="40" value="<%= form ? form.name : '' %>" required></label>
      <label>Startscore <input type="number" name="start_score" min="1" max="1001" value="<%= form ? form.start_score : 501 %>" required></label>
    </div>
    <div class="checks">
      <label class="check"><input type="checkbox" name="double_in" value="1" <%= form && form.double_in ? 'checked' : '' %>> Double In</label>
      <label class="check"><input type="checkbox" name="double_out" value="1" <%= form && form.double_out ? 'checked' : '' %>> Double Out</label>
    </div>
    <button class="btn primary" type="submit">Anlegen</button>
  </form>
</section>

<h2>Bestehende Modi</h2>
<% modes.forEach(function (m) { %>
  <section class="card <%= m.aktiv ? '' : 'inactive' %>">
    <form method="post" action="/admin/modes/<%= m.id %>" class="form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="two">
        <label>Name <input type="text" name="name" maxlength="40" value="<%= m.name %>" required></label>
        <label>Startscore <input type="number" name="start_score" min="1" max="1001" value="<%= m.start_score %>" required></label>
      </div>
      <div class="checks">
        <label class="check"><input type="checkbox" name="double_in" value="1" <%= m.double_in ? 'checked' : '' %>> Double In</label>
        <label class="check"><input type="checkbox" name="double_out" value="1" <%= m.double_out ? 'checked' : '' %>> Double Out</label>
      </div>
      <button class="btn" type="submit">Speichern</button>
    </form>
    <form method="post" action="/admin/modes/<%= m.id %>/toggle" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn" type="submit"><%= m.aktiv ? 'Deaktivieren' : 'Wieder aktivieren' %></button>
    </form>
  </section>
<% }) %>
<%- include('../partials/footer') %>
